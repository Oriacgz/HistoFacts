# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/histofacts

# JWT
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# LLM — LM Studio / Local Model (AI Notes)
LLM_PROVIDER=lm_studio
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen3-vl-4b-thinking
# AI Notes: fast by default, reasoning only when Think is enabled.
NOTES_LLM_BASE_URL=http://127.0.0.1:11434/v1
NOTES_LLM_MODEL=llama3.2:3b
NOTES_THINKING_LLM_BASE_URL=http://localhost:1234/v1
NOTES_THINKING_LLM_MODEL=qwen3-vl-4b-thinking
# Quiz-only non-thinking model; use the exact ID loaded in your server.
QUIZ_LLM_BASE_URL=http://127.0.0.1:11434/v1
QUIZ_LLM_MODEL=llama3.2:3b
QUIZ_GENERATION_TIMEOUT_SECONDS=150
QUIZ_CONTEXT_LENGTH=8192
LLM_API_KEY=not-needed

# Wikimedia API Token (Optional)
WIKIMEDIA_API_TOKEN=

# History module — AI "did you know" hook (Groq cloud LLM or Gemini)
GROQ_API_KEY=
GEMINI_API_KEY=

# Tenor GIF search (community comments, chat)
TENOR_API_KEY=

# Web Research: optional free-tier Tavily key; never exposed to the browser.
# Leave empty to keep live research unavailable. Do not enable provider paid overage.
TAVILY_API_KEY=

# AI Notes session context: match the ACTUAL loaded limit in Ollama/LM Studio.
# The UI labels conservative UTF-8 accounting as estimated, not tokenizer-exact.
NOTES_CONTEXT_LIMIT=8192
NOTES_RESEARCH_THINK_OUTPUT_TOKENS=3072
# Optional locally evaluated Nomic recall. Sliding window + extractive memory works without it.
NOTES_MEMORY_DENSE_ENABLED=false

# Per-session memory buffer, independent from the model's actual prompt capacity.
NOTES_SESSION_WINDOW_TOKENS=150000
