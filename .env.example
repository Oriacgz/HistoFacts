# =================================================================
# HistoFacts — Environment Variables Configuration Template
# Copy this file to .env and configure for your local/production env
# =================================================================

# Database Connection (Async PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/histofacts

# Security & JWT Authentication
SECRET_KEY=change-to-a-secure-random-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# AI Notes Generation (Optional LLM Key)
LLM_API_KEY=
LLM_PROVIDER=openai

# Microservices URLs (Development Gateway)
AUTH_SERVICE_URL=http://127.0.0.1:8001
HISTORY_SERVICE_URL=http://127.0.0.1:8002
SOCIAL_SERVICE_URL=http://127.0.0.1:8003
GROUPS_SERVICE_URL=http://127.0.0.1:8004
NOTES_SERVICE_URL=http://127.0.0.1:8005
QUIZ_SERVICE_URL=http://127.0.0.1:8006
